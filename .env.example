# FACM — configuration locale (copier vers .env pour personnaliser)

# Port du serveur local
FACM_PORT=4560

# Hôte d'écoute (127.0.0.1 = local uniquement, recommandé)
FACM_HOST=127.0.0.1

# Dossier des données locales (cache SQLite, exports générés)
FACM_DATA_DIR=./data

# Langue par défaut de l'interface (fr | en)
FACM_LANG=fr

# Nombre de workers pour l'analyse parallèle (0 = auto: nb CPU - 1, max 4)
FACM_WORKERS=0

# --- Sécurité ---
# Jeton de session API : généré automatiquement au démarrage si absent.
# L'URL de lancement (affichée en console) le contient — l'API refuse tout
# appel sans ce jeton (protection contre les autres process locaux).
# FACM_TOKEN=

# Désactiver le jeton (développement uniquement, jamais en usage réel)
# FACM_DISABLE_TOKEN=1
